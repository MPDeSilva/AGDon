# SMTP — use a transactional provider (Resend, Brevo, SES, Postmark — NOT raw Gmail)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here

# Email addresses
MAIL_TO=vgdonservices@gmail.com
MAIL_FROM=noreply@vgdonservices.co.uk

# Cloudflare Turnstile — SITE KEY is public (NEXT_PUBLIC_), SECRET stays server-only
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Upstash Redis — rate limiting (get from upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Site URL
NEXT_PUBLIC_SITE_URL=https://vgdonservices.co.uk
